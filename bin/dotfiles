#!/usr/bin/env bash
# dotfiles — compose a machine from layers.
#
#   dotfiles install --profile mac-dev
#   dotfiles install --profile core --dry-run
#   dotfiles list
#   dotfiles status
#
set -euo pipefail

# A layer function that ends on a false test (`has gh && log_warn ...`) returns
# non-zero and, under set -e, aborts the run with no output at all. This makes
# that failure mode impossible to miss.
trap 'rc=$?; [[ $rc -ne 0 ]] && printf "\n\033[31m error\033[0m aborted at %s:%s (exit %s)\n" "${BASH_SOURCE[0]##*/}" "$LINENO" "$rc" >&2; exit $rc' ERR

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT

# shellcheck source=../lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"
source "$DOTFILES_ROOT/lib/os.sh"
source "$DOTFILES_ROOT/lib/link.sh"
source "$DOTFILES_ROOT/lib/pkg.sh"
source "$DOTFILES_ROOT/lib/layers.sh"
source "$DOTFILES_ROOT/lib/key.sh"
source "$DOTFILES_ROOT/lib/github.sh"

usage() {
  cat <<'HELPTEXT'
dotfiles — compose a machine from layers

USAGE
  dotfiles install [options]   install layers and link config
  dotfiles list                show available profiles and layers
  dotfiles status              show what is installed on this machine
  dotfiles link                re-link $HOME files only (no packages)
  dotfiles doctor              check the current machine for problems
  dotfiles key <sub>           move the signing key between machines safely
  dotfiles github              register your ssh + gpg keys with GitHub

INSTALL OPTIONS
  -p, --profile NAME   profile to install (default: core, or mac-dev on macOS)
      --with LAYER     add a layer on top of the profile (repeatable)
      --without LAYER  drop a layer from the profile (repeatable)
  -n, --dry-run        print what would happen, change nothing
  -y, --yes            assume yes for prompts
  -h, --help           this text

EXAMPLES
  # Linux devcontainer: zsh + git only
  dotfiles install --profile core

  # VM that only needs Chrome, VS Code and Claude
  dotfiles install --profile mac-minimal

  # Full workstation, minus the quality-of-life apps
  dotfiles install --profile mac-full --without mac-apps-extra

  # Work machine
  dotfiles install --profile mac-full --with work-harper

  # Sign with the ssh key instead of gpg (no gpg key needed on this machine)
  DOTFILES_SIGNING=ssh dotfiles install --profile mac-dev

ENVIRONMENT
  DOTFILES_SIGNING       auto (default) | gpg | ssh | off
  DOTFILES_COMPUTER_NAME set the macOS computer name unattended
HELPTEXT
}

cmd_list() {
  log_head "Profiles"
  local p
  for p in $(all_profiles); do
    printf '  %s%-14s%s %s\n' "$_C_BOLD" "$p" "$_C_RESET" \
      "$(profile_layers "$p" | tr '\n' ' ')"
  done

  log_head "Layers"
  local l plat
  for l in $(all_layers); do
    plat="$(layer_meta "$l" PLATFORMS)"
    printf '  %s%-18s%s %-14s %s\n' "$_C_BOLD" "$l" "$_C_RESET" \
      "[${plat:-any}]" "$(layer_meta "$l" DESCRIPTION)"
  done
  printf '\n'
}

cmd_status() {
  log_head "Machine"
  printf '  platform   %s (%s)%s\n' "$(os_kind)" "$(os_arch)" \
    "$(is_container && printf ', container' || true)"
  printf '  repo       %s\n' "$(pretty_path "$DOTFILES_ROOT")"

  if [[ -f "$STATE_DIR/init.sh" ]]; then
    printf '  profile    %s\n' "$(sed -n 's/^export DOTFILES_PROFILE="\(.*\)"$/\1/p' "$STATE_DIR/init.sh")"
    printf '  layers     %s\n' "$(sed -n 's/^export DOTFILES_LAYERS="\(.*\)"$/\1/p' "$STATE_DIR/init.sh")"
    printf '  installed  %s\n' "$(sed -n 's/^# Generated by .* on \(.*\)\.$/\1/p' "$STATE_DIR/init.sh")"
  else
    printf '  %sno install recorded — run `dotfiles install`%s\n' "$_C_YELLOW" "$_C_RESET"
  fi

  log_head "Linked files"
  local f target
  for f in "$HOME"/.zshrc "$HOME"/.zshenv "$HOME"/.zprofile "$HOME"/.gitconfig "$HOME"/.gitignore_global; do
    if [[ -L "$f" ]]; then
      target="$(readlink "$f")"
      if [[ "$target" == "$DOTFILES_ROOT"/* ]]; then
        printf '  %sok%s   %-22s -> %s\n' "$_C_GREEN" "$_C_RESET" "$(pretty_path "$f")" "$(pretty_path "$target")"
      else
        printf '  %s!!%s   %-22s -> %s (foreign)\n' "$_C_YELLOW" "$_C_RESET" "$(pretty_path "$f")" "$target"
      fi
    elif [[ -e "$f" ]]; then
      printf '  %s!!%s   %-22s (regular file, not linked)\n' "$_C_YELLOW" "$_C_RESET" "$(pretty_path "$f")"
    else
      printf '  %s--%s   %-22s (absent)\n' "$_C_DIM" "$_C_RESET" "$(pretty_path "$f")"
    fi
  done
  printf '\n'
}

cmd_doctor() {
  local problems=0
  log_head "Doctor"

  for tool in git zsh; do
    if has "$tool"; then log_ok "$tool $(command -v "$tool")"
    else log_err "$tool not installed"; problems=$((problems+1)); fi
  done

  if [[ "$SHELL" == *zsh ]]; then
    log_ok "login shell is zsh"
  elif is_container; then
    log_skip "login shell is $SHELL (containers keep the image default)"
  else
    log_warn "login shell is $SHELL, not zsh — run: chsh -s \$(command -v zsh)"
    problems=$((problems+1))
  fi

  # ssh
  local ssh_key="${CORE_SSH_KEY:-$HOME/.ssh/id_ed25519}"
  if [[ -f "$ssh_key" ]]; then
    log_ok "ssh key $(pretty_path "$ssh_key")"
    local fp; fp="$(ssh-keygen -lf "$ssh_key" 2>/dev/null | awk '{print $2}')"
    if [[ -n "$fp" ]] && ssh-add -l 2>/dev/null | grep -qF "$fp"; then
      log_ok "ssh key loaded in the agent"
    else
      log_warn "ssh key is not in the agent — run: ssh-add $ssh_key"
      problems=$((problems+1))
    fi
  else
    log_warn "no ssh key at $(pretty_path "$ssh_key")"
    problems=$((problems+1))
  fi

  if [[ -f "$HOME/.ssh/config" ]] && grep -qF 'config.d/' "$HOME/.ssh/config"; then
    log_ok "~/.ssh/config includes config.d/"
  else
    log_warn "~/.ssh/config does not include config.d/ — run: dotfiles install"
    problems=$((problems+1))
  fi

  if has ssh && [[ -f "$ssh_key" ]]; then
    local probe; probe="$(ssh -o BatchMode=yes -o ConnectTimeout=8 -T git@github.com 2>&1 || true)"
    case "$probe" in
      *"successfully authenticated"*) log_ok "github ssh authentication works" ;;
      *"Permission denied"*) log_warn "github rejected the ssh key — register it: gh ssh-key add $ssh_key.pub"; problems=$((problems+1)) ;;
      *) log_skip "github ssh probe inconclusive (offline?)" ;;
    esac
  fi

  local key; key="$(git config --global user.signingkey || true)"
  local fmt; fmt="$(git config --global gpg.format || echo openpgp)"
  if [[ -n "$key" && "$fmt" == "ssh" ]]; then
    if [[ -f "${key/#\~/$HOME}" ]]; then
      log_ok "signing with ssh key $(pretty_path "$key")"
      [[ -f "$HOME/.ssh/allowed_signers" ]] \
        && log_ok "allowed_signers present (local verification works)" \
        || { log_warn "no ~/.ssh/allowed_signers — git can sign but not verify"; problems=$((problems+1)); }
    else
      log_err "git signs with $key but that file does not exist"
      problems=$((problems+1))
    fi
  elif [[ -n "$key" ]]; then
    if has gpg && gpg --list-secret-keys "$key" >/dev/null 2>&1; then
      log_ok "gpg signing key $key present"
      local expiry
      expiry="$(gpg --list-secret-keys --with-colons "$key" 2>/dev/null | awk -F: '/^sec/{print $7; exit}')"
      if [[ -n "$expiry" && "$expiry" != "0" ]]; then
        local days=$(( (expiry - $(date +%s)) / 86400 ))
        if   (( days < 0 ));  then log_err "signing key EXPIRED $(( -days )) days ago"; problems=$((problems+1))
        elif (( days < 60 )); then log_warn "signing key expires in $days days"
        else log_ok "signing key valid for $days more days"; fi
      fi
    else
      log_warn "git is configured to sign with $key but it is not in the keyring"
      problems=$((problems+1))
    fi
  else
    log_skip "no gpg signing key configured"
  fi

  if is_macos; then
    if brew_bin >/dev/null; then log_ok "homebrew $(brew_bin)"
    else log_err "homebrew missing"; problems=$((problems+1)); fi
    if xcode-select -p >/dev/null 2>&1; then log_ok "xcode command line tools"
    else log_err "xcode command line tools missing"; problems=$((problems+1)); fi
  fi

  # Symlinks pointing at a repo that has since moved.
  local f
  for f in "$HOME"/.zshrc "$HOME"/.zshenv "$HOME"/.zprofile "$HOME"/.gitconfig; do
    if [[ -L "$f" ]] && [[ ! -e "$f" ]]; then
      log_err "$(pretty_path "$f") is a broken symlink -> $(readlink "$f")"
      problems=$((problems+1))
    fi
  done

  printf '\n'
  if (( problems == 0 )); then log_ok "no problems found"
  else log_warn "$problems problem(s) found"; return 1; fi
}

cmd_link() {
  local layers; layers="$(installed_layers)"
  [[ -n "$layers" ]] || log_die "nothing installed yet — run \`dotfiles install\` first"
  log_head "Re-linking \$HOME files"
  local l
  for l in $layers; do link_home_dir "$(layer_dir "$l")"; done
}

installed_layers() {
  [[ -f "$STATE_DIR/init.sh" ]] || return 0
  sed -n 's/^export DOTFILES_LAYERS="\(.*\)"$/\1/p' "$STATE_DIR/init.sh"
}

cmd_install() {
  local profile="" with=() without=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--profile) profile="${2:?--profile needs a value}"; shift 2 ;;
      --with)       with+=("${2:?--with needs a value}"); shift 2 ;;
      --without)    without+=("${2:?--without needs a value}"); shift 2 ;;
      -n|--dry-run) DOTFILES_DRY_RUN=1; shift ;;
      -y|--yes)     DOTFILES_ASSUME_YES=1; shift ;;
      -h|--help)    usage; return 0 ;;
      *)            log_die "unknown option: $1" ;;
    esac
  done

  if [[ -z "$profile" ]]; then
    if is_macos && ! is_container; then profile=mac-dev; else profile=core; fi
    log_step "no --profile given, defaulting to '$profile'"
  fi

  profile_layers "$profile" >/dev/null 2>&1 \
    || log_die "unknown profile '$profile' (available: $(all_profiles | tr '\n' ' '))"

  # Validate explicitly named layers up front: a typo in --with must fail
  # loudly rather than quietly installing one layer fewer than you asked for.
  local known; known=" $(all_layers | tr '\n' ' ') "
  local l
  for l in "${with[@]:-}" "${without[@]:-}"; do
    [[ -z "$l" ]] && continue
    [[ "$known" == *" $l "* ]] \
      || log_die "unknown layer '$l' (available: $(all_layers | tr '\n' ' '))"
  done

  export DOTFILES_PROFILE="$profile"
  export DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-0}"
  export DOTFILES_ASSUME_YES="${DOTFILES_ASSUME_YES:-0}"

  # profile ∪ --with ∖ --without, ordered by directory prefix.
  local selected
  selected="$( { profile_layers "$profile"; printf '%s\n' "${with[@]:-}"; } | sort_layers )"
  local skip final=()
  for l in $selected; do
    skip=0
    for w in "${without[@]:-}"; do [[ "$l" == "$w" ]] && skip=1; done
    (( skip )) || final+=("$l")
  done

  [[ ${#final[@]} -gt 0 ]] || log_die "no layers selected"

  # Refuse platform mismatches before touching anything.
  for l in "${final[@]}"; do
    layer_supports_platform "$l" \
      || log_die "layer '$l' does not support $(os_kind) (supports: $(layer_meta "$l" PLATFORMS))"
  done

  log_head "Plan"
  printf '  profile   %s\n' "$profile"
  printf '  platform  %s (%s)\n' "$(os_kind)" "$(os_arch)"
  printf '  layers    %s\n' "${final[*]}"
  [[ "$DOTFILES_DRY_RUN" == "1" ]] && printf '  %sdry run — nothing will change%s\n' "$_C_YELLOW" "$_C_RESET"

  if [[ "$DOTFILES_DRY_RUN" != "1" ]]; then
    confirm "Proceed?" || log_die "aborted"
  fi

  for l in "${final[@]}"; do
    local dir; dir="$(layer_dir "$l")"
    log_head "Layer: $l — $(layer_meta "$l" DESCRIPTION)"
    if [[ -f "$dir/install.sh" ]]; then
      # shellcheck disable=SC1090
      LAYER_DIR="$dir" source "$dir/install.sh"
    fi
    link_home_dir "$dir"
  done

  log_head "Shell init"
  write_init_file "${final[@]}"

  log_head "Done"
  if [[ "$DOTFILES_DRY_RUN" == "1" ]]; then
    printf '  dry run complete — re-run without --dry-run to apply\n\n'
  else
    [[ -d "${DOTFILES_BACKUP_DIR:-}" ]] && printf '  replaced files backed up to %s\n' "$(pretty_path "$DOTFILES_BACKUP_DIR")"
    printf '  open a new shell, or: %sexec zsh%s\n\n' "$_C_BOLD" "$_C_RESET"
  fi
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install)      cmd_install "$@" ;;
    list|ls)      cmd_list ;;
    status)       cmd_status ;;
    link)         cmd_link ;;
    doctor)       cmd_doctor ;;
    key)          cmd_key "$@" ;;
    github|gh)    cmd_github ;;
    help|-h|--help) usage ;;
    *)            log_err "unknown command: $cmd"; printf '\n'; usage; exit 1 ;;
  esac
}

main "$@"
