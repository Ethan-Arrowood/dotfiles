# macOS defaults: `domain key type value`, one per line. Each is read first
# and only written when it differs, so re-runs change nothing.
# Trackpad, mouse, appearance and keyboard changes apply at next login.

# Keyboard
NSGlobalDomain  ApplePressAndHoldEnabled                -bool   false
NSGlobalDomain  KeyRepeat                               -int    2
NSGlobalDomain  InitialKeyRepeat                        -int    15
NSGlobalDomain  AppleKeyboardUIMode                     -int    2       # Tab moves between all controls

# Typing: no auto-correct, auto-capitalise, double-space period or smart punctuation
NSGlobalDomain  NSAutomaticSpellingCorrectionEnabled    -bool   false
NSGlobalDomain  WebAutomaticSpellingCorrectionEnabled   -bool   false
NSGlobalDomain  NSAutomaticCapitalizationEnabled        -bool   false
NSGlobalDomain  NSAutomaticPeriodSubstitutionEnabled    -bool   false
NSGlobalDomain  NSAutomaticQuoteSubstitutionEnabled     -bool   false
NSGlobalDomain  NSAutomaticDashSubstitutionEnabled      -bool   false

# Trackpad: no tap to click, no three-finger drag, two-finger right-click.
# Both domains: the built-in trackpad and a Bluetooth Magic Trackpad.
com.apple.AppleMultitouchTrackpad                   Clicking                 -bool  false
com.apple.AppleMultitouchTrackpad                   TrackpadThreeFingerDrag  -bool  false
com.apple.AppleMultitouchTrackpad                   TrackpadRightClick       -bool  true
com.apple.driver.AppleBluetoothMultitouch.trackpad  Clicking                 -bool  false
com.apple.driver.AppleBluetoothMultitouch.trackpad  TrackpadThreeFingerDrag  -bool  false
com.apple.driver.AppleBluetoothMultitouch.trackpad  TrackpadRightClick       -bool  true

# Pointer speed (0-3) and scroll direction
NSGlobalDomain  com.apple.trackpad.scaling              -float  1
NSGlobalDomain  com.apple.mouse.scaling                 -float  3
NSGlobalDomain  com.apple.swipescrolldirection          -bool   false   # natural scrolling off

# Appearance and sound
NSGlobalDomain          AppleInterfaceStyle                 -string  Dark
com.apple.systemsound   com.apple.sound.uiaudio.enabled     -int     0   # UI sound effects off
NSGlobalDomain          com.apple.sound.beep.feedback       -int     0   # no sound on volume change
com.apple.Siri          StatusMenuVisible                   -bool    false

# Dock
com.apple.dock  autohide        -bool   true
com.apple.dock  autohide-delay  -float  0
com.apple.dock  magnification   -bool   false
com.apple.dock  tilesize        -float  64
com.apple.dock  show-recents    -bool   false

# Finder
NSGlobalDomain             AppleShowAllExtensions              -bool    true
NSGlobalDomain             NSDocumentSaveNewDocumentsToCloud   -bool    false
com.apple.finder           AppleShowAllFiles                   -bool    true
com.apple.finder           ShowPathbar                         -bool    true
com.apple.finder           ShowStatusBar                       -bool    true
com.apple.finder           FXPreferredViewStyle                -string  Nlsv   # list view
com.apple.finder           _FXSortFoldersFirst                 -bool    true
com.apple.finder           FXDefaultSearchScope                -string  SCcf   # search the current folder
com.apple.desktopservices  DSDontWriteNetworkStores            -bool    true

# Screenshots
com.apple.screencapture  disable-shadow  -bool    true
com.apple.screencapture  location        -string  ~/Downloads
