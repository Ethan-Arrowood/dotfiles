# Skills for any dev machine. Cloned to ~/dev/<owner>/<repo> and symlinked
# into ~/.claude/skills/, so the checkout is both the installed skill and an
# editable source tree — edits are live, no re-sync.
#
#   repo  <owner>/<repo>            every skill in the repo
#   skill <owner>/<repo>#<skill>    just that one
#   rules <owner>/<repo>            its rules/*.md -> ~/.claude/rules/

repo Ethan-Arrowood/skills
rules Ethan-Arrowood/skills
