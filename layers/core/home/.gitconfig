# Machine-specific settings use the includes below.

[user]
	name = Ethan Arrowood
	email = ethan@arrowood.dev

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = false

[fetch]
	prune = true
	pruneTags = true

[core]
	excludesfile = ~/.gitignore_global
	editor = vim

[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
	renames = true

[merge]
	conflictStyle = zdiff3

# Reuse conflict resolutions across rebases and cherry-picks.
[rerere]
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate

[log]
	date = iso

[rebase]
	autoSquash = true
	autoStash = true

[status]
	showUntrackedFiles = all

[alias]
	s = status --short --branch
	co = checkout
	br = branch
	ll = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	pushf = push --force-with-lease
	root = rev-parse --show-toplevel

# Keep HTTPS fetches usable before SSH keys exist. Only pushes need SSH.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

# --- machine-local layers ----------------------------------------------------
# Both are generated by `dotfiles install`; git ignores them when absent.
# Paths are relative to the directory holding ~/.gitconfig, not to HOME.
# They still resolve when git runs with another HOME and includes this file.

# Signing key and commit.gpgsign: only written when this machine has an ssh key.
[include]
	path = .config/dotfiles/gitconfig.signing

# Tool integrations (delta, etc.): written by whichever layer installs them.
[include]
	path = .config/dotfiles/gitconfig.tools

# Anything else specific to this machine. Last, so it wins.
[include]
	path = .gitconfig.local

# Use ethan@arrowood.dev everywhere. For a repo requiring another address:
#
#   [includeIf "gitdir:~/dev/somewhere/"]
#   	path = .config/dotfiles/gitconfig.somewhere
#
# Put [user] email = ... in that file.
