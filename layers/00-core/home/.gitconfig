# Tracked in the dotfiles repo. Anything machine-specific (signing key,
# work identities) is layered on through the includes at the bottom.

[user]
	name = Ethan Arrowood
	email = ethan@arrowood.dev

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = false

[fetch]
	prune = true
	pruneTags = true

[core]
	excludesfile = ~/.gitignore_global
	editor = vim

[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
	renames = true

[merge]
	conflictStyle = zdiff3

# Remember conflict resolutions and replay them. Pays for itself on any
# long-lived branch or repeated cherry-pick.
[rerere]
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate

[log]
	date = iso

[rebase]
	autoSquash = true
	autoStash = true

[status]
	showUntrackedFiles = all

[alias]
	s = status --short --branch
	co = checkout
	br = branch
	ll = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	pushf = push --force-with-lease
	root = rev-parse --show-toplevel

[url "git@github.com:"]
	insteadOf = https://github.com/

# --- machine-local layers ----------------------------------------------------
# Both are generated by `dotfiles install`; git ignores them when absent.

# Signing key and commit.gpgsign — only written when the key is in the keyring.
[include]
	path = ~/.config/dotfiles/gitconfig.signing

# Tool integrations (delta, etc.) — written by whichever layer installs them.
[include]
	path = ~/.config/dotfiles/gitconfig.tools

# Anything else specific to this machine. Last, so it wins.
[include]
	path = ~/.gitconfig.local

# Work identity, applied only inside work checkouts.
[includeIf "gitdir:~/dev/harperfast/"]
	path = ~/.config/dotfiles/gitconfig.work
